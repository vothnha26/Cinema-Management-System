@startuml Manager Promotion Activity
title Activity Diagram: Quản lý Khuyến mãi (Task 6 Refactored)
skinparam theme cerulean

start
:Truy cập Quản lý Khuyến mãi;
:Nhấn "Tạo chương trình mới";
:Nhập Mã (Code), Tên, Loại giảm (%, Cố định), Mức giảm;

partition "Thiết lập Điều kiện áp dụng" {
    :Chọn Hạng thành viên tối thiểu (Min Tier);
    :Chọn Khoảng thời gian hiệu lực (Start-End);
    :Nhập Đơn hàng tối thiểu (Min Order Amount);
    :Nhập Mức giảm tối đa (Max Discount);
    :Nhập Giới hạn lượt dùng (Usage Limit);
}

if (Dữ liệu hợp lệ?) then (Có)
    :Lưu chương trình (Sử dụng Builder Pattern);
    :Thông báo "Tạo khuyến mãi thành công";
else (Không)
    :Yêu cầu chỉnh sửa;
    stop
endif

partition "Promotion Engine (Khi áp dụng mã)" {
    :Kiểm tra Trạng thái, Thời hạn;
    :Kiểm tra Hạng thành viên (Security Context);
    :Kiểm tra Lượt dùng & Giá trị đơn hàng;
    
    if (Hợp lệ?) then (Đúng)
        :Xác định Strategy (Factory);
        :Tính toán số tiền giảm thực tế;
        :Hiển thị số tiền giảm lên UI;
    else (Sai)
        :Thông báo lý do từ chối (Exception);
    endif
}

stop
@enduml
