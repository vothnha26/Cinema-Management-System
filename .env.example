# StarCinema Environment Variables Template
# Copy file này thành .env và điền giá trị thực tế của bạn

# TMDB API
TMDB_API_KEY=your_tmdb_api_key_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail App Password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# Database (Optional defaults are in application.properties)
DB_USERNAME=root
DB_PASSWORD=123456
JWT_SECRET=your_super_secret_key

# SePay Configuration
SEPAY_SECRET=your_sepay_api_key_here
SEPAY_BANK_NAME=VietinBank
SEPAY_BANK_ACCOUNT=109879673245
SEPAY_BANK_BIN=970415
SEPAY_PREFIX=SEVQR 
SEPAY_CALLBACK_PATH=/api/public/payments/webhook
