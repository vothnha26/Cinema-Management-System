@startuml StarCinema Database Design (ERD)
' hide the spot
hide circle
' avoid problems with angled crows feet
skinparam linetype ortho
skinparam theme cerulean

entity "users" as users {
  * id : BIGINT <<PK>>
  --
  username : VARCHAR(255) <<UNIQUE>>
  password : VARCHAR(255)
  email : VARCHAR(255) <<UNIQUE>>
  role : ENUM('ADMIN','MANAGER','STAFF','CUSTOMER')
  status : BOOLEAN
  created_at : TIMESTAMP
}

entity "customers" as customers {
  * id : BIGINT <<PK>>
  --
  user_id : BIGINT <<FK>>
  full_name : VARCHAR(255)
  phone : VARCHAR(20)
  membership_tier : ENUM('STANDARD','SILVER','GOLD','PLATINUM')
  total_spending : DECIMAL(15,2)
  accumulated_points : DOUBLE
}

entity "membership_benefits" as membership_benefits {
  * id : BIGINT <<PK>>
  --
  tier : ENUM('STANDARD','SILVER','GOLD','PLATINUM') <<UNIQUE>>
  discount_percent : DOUBLE
  point_multiplier : DOUBLE
}

entity "movies" as movies {
  * id : BIGINT <<PK>>
  --
  title : VARCHAR(255)
  description : TEXT
  duration : INT (minutes)
  release_date : DATE
  status : ENUM('COMING_SOON','NOW_SHOWING','STOPPED')
  age_rating : ENUM('P','K','T13','T16','T18')
  poster_url : VARCHAR(500)
  trailer_url : VARCHAR(500)
  popularity : DOUBLE
}

entity "genres" as genres {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR(100) <<UNIQUE>>
}

entity "formats" as formats {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR(20) <<UNIQUE>> (2D, 3D, IMAX)
}

entity "directors" as directors {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR(255)
  avatar_url : VARCHAR(500)
}

entity "actors" as actors {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR(255)
  avatar_url : VARCHAR(500)
}

entity "movie_genres" as movie_genres {
  * movie_id : BIGINT <<PK, FK>>
  * genre_id : BIGINT <<PK, FK>>
}

entity "movie_directors" as movie_directors {
  * movie_id : BIGINT <<PK, FK>>
  * director_id : BIGINT <<PK, FK>>
  --
  role : VARCHAR(100) (MAIN, CO_DIRECTOR)
}

entity "movie_actors" as movie_actors {
  * movie_id : BIGINT <<PK, FK>>
  * actor_id : BIGINT <<PK, FK>>
  --
  character_name : VARCHAR(255)
  display_order : INT
}

entity "rooms" as rooms {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR(100)
  type : ENUM('HALL_2D','HALL_3D','IMAX','HALL_4DX')
  capacity : INT
  status : BOOLEAN
}

entity "seats" as seats {
  * id : BIGINT <<PK>>
  --
  room_id : BIGINT <<FK>>
  row_char : VARCHAR(2)
  col_num : INT
  type : ENUM('STANDARD','VIP','COUPLE')
}

entity "seat_prices" as seat_prices {
  * id : BIGINT <<PK>>
  --
  room_type : ENUM('HALL_2D','HALL_3D','IMAX','HALL_4DX')
  seat_type : ENUM('STANDARD','VIP','COUPLE')
  price : DECIMAL(10,2)
  is_active : BOOLEAN
}

entity "showtimes" as showtimes {
  * id : BIGINT <<PK>>
  --
  movie_id : BIGINT <<FK>>
  room_id : BIGINT <<FK>>
  format_id : BIGINT <<FK>>
  start_time : DATETIME
  end_time : DATETIME
  status : ENUM('UPCOMING','SHOWING','ENDED','CANCELLED')
  total_seats : INT
  sold_seats : INT <<Formula>>
}

entity "bookings" as bookings {
  * id : BIGINT <<PK>>
  --
  customer_id : BIGINT <<FK>>
  showtime_id : BIGINT <<FK>>
  promotion_id : BIGINT <<FK>>
  booking_code : VARCHAR(20) <<UNIQUE>>
  total_price : DECIMAL(15,2)
  discount_amount : DECIMAL(15,2)
  final_price : DECIMAL(15,2)
  status : ENUM('PENDING','CONFIRMED','CANCELLED','CHECKED_IN')
  created_at : TIMESTAMP
}

entity "booking_details" as booking_details {
  * id : BIGINT <<PK>>
  --
  booking_id : BIGINT <<FK>>
  seat_id : BIGINT <<FK>>
  price : DECIMAL(10,2)
}

entity "combos" as combos {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR(255)
  description : TEXT
  price : DECIMAL(10,2)
  image_url : VARCHAR(500)
  is_active : BOOLEAN
}

entity "booking_combos" as booking_combos {
  * id : BIGINT <<PK>>
  --
  booking_id : BIGINT <<FK>>
  combo_id : BIGINT <<FK>>
  quantity : INT
  price : DECIMAL(10,2)
}

entity "promotions" as promotions {
  * id : BIGINT <<PK>>
  --
  code : VARCHAR(50) <<UNIQUE>>
  name : VARCHAR(255)
  discount_type : ENUM('PERCENT','FIXED')
  discount_value : DECIMAL(10,2)
  max_discount : DECIMAL(10,2)
  min_order_value : DECIMAL(10,2)
  start_date : DATETIME
  end_date : DATETIME
  usage_limit : INT
  used_count : INT
  is_active : BOOLEAN
}

entity "payments" as payments {
  * id : BIGINT <<PK>>
  --
  booking_id : BIGINT <<FK>>
  amount : DECIMAL(15,2)
  method : ENUM('CASH','VNPAY','MOMO','STRIPE')
  status : ENUM('PENDING','SUCCESS','FAILED','REFUNDED')
  transaction_id : VARCHAR(255)
  paid_at : TIMESTAMP
}

entity "audit_logs" as audit_logs {
  * id : BIGINT <<PK>>
  --
  username : VARCHAR(255)
  action : VARCHAR(100)
  target : VARCHAR(100)
  target_id : BIGINT
  details : TEXT
  timestamp : TIMESTAMP
}

entity "pricing_rules" as pricing_rules {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR(255)
  type : ENUM('ADDITIVE','PERCENTAGE')
  value : DECIMAL(10,2)
  priority : INT
  start_time : TIME
  end_time : TIME
  applicable_room_type : VARCHAR(50)
  applicable_seat_type : VARCHAR(50)
  is_active : BOOLEAN
}

' Relationships
users ||--o| customers
movies ||--o{ movie_genres
genres ||--o{ movie_genres
movies ||--o{ movie_directors
directors ||--o{ movie_directors
movies ||--o{ movie_actors
actors ||--o{ movie_actors

movies ||--o{ showtimes
rooms ||--o{ showtimes
formats ||--o{ showtimes

rooms ||--o{ seats
showtimes ||--o{ bookings
customers ||--o{ bookings
promotions ||--o{ bookings

bookings ||--o{ booking_details
seats ||--o{ booking_details

bookings ||--o{ booking_combos
combos ||--o{ booking_combos

bookings ||--|| payments

membership_benefits }o--|| customers : "match tier"

@enduml
